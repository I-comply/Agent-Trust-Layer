# Sandbox worker image for ATL_EXECUTOR=docker. Push to a registry and set ATL_DOCKER_IMAGE=<repo>@sha256:<digest>.
# worker.py is NOT baked in: it is bind-mounted read-only per call.
FROM python@sha256:f17ec845ebdd4f3347431579e1c22eaeec82913f039f2a54b937c7ff870bacdb
ENV PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
